# debate output is re-derivable from the palace: only the changed code matters.
cases/
# build products, maps, generated c/bin assets and the .nds binary.
*.o
*.elf
*.nds
*.map
*.lst
build/
*.tmp
atlas.h
atlas.img.bin
atlas.pal.bin
*.grit2
.venv/

# bots don't need to see build intermediate c/h files, only inputs matter.
build/gfx/*.c
build/gfx/*.h

# local meta
.DS_Store
Thumbs.db
# debate/run case artifacts are idempotent and re-derivable from the palace
cases/raw
cases/*/raw

# python bytecode
__pycache__/
*.sav
